# How callers authenticate: `token` (default, standalone) or `federated` (MW Identity).
# A control plane with an identity provider uses federated. See admin/README.md.
ADMIN_AUTH_MODE=token

# token mode: one entry per person or job, name:sha256-of-token:scopes[:expires], separated by ';'.
# Generate with:  mqtt-admin token new --name ops --scopes write --expires 2027-01-31
# The token itself is shown once and is never put here; only its hash is.
MQTT_ADMIN_TOKENS=ops:replace-with-the-64-character-sha256:write:2027-01-31

# Password of the broker user `mqtt-admin-api` (role dynsec-admin). Create it with:
#   sh /stackport-scripts/provision-client.sh mqtt-admin-api dynsec-admin
MQTT_API_PASSWORD=replace-with-the-password-you-gave-mqtt-admin-api

# federated mode only. Address of MW Identity reachable from this project (its public URL is fine).
MW_IDENTITY_INTERNAL_BASE_URL=https://identity.example.org

# The one-time secret issued when registering the `mw-mqtt` resource application.
MW_IDENTITY_INTROSPECTION_CLIENT_SECRET=replace-with-the-issued-secret

# Optional overrides (defaults shown):
# MW_IDENTITY_INTROSPECTION_CLIENT_ID=mw-mqtt
# MW_IDENTITY_AUDIENCE=mw-mqtt
# MQTT_ALLOWED_ROLES=            (optional allow-list; empty = every role that is not reserved)
# MQTT_RESERVED_ROLES=admin,dynsec-admin
# MQTT_DEFAULT_ROLE=             (role for a new client when the caller names none)
# MQTT_PROTECTED_USERS=mqtt-admin
# The certificate name to verify. Defaults to the host of MQTT_BROKER_URL ("mqtt"), so set it
# when the broker certificate carries the public name:
# MQTT_TLS_SERVER_NAME=mqtt.example.org
# Values shown in the served documentation:
# MQTT_PUBLIC_HOST=mqtt.example.org
# MQTT_PUBLIC_PORT=8883
# MQTT_WS_URL=wss://mqtt-ws.example.org/mqtt     (omit when there is no WebSocket listener)
# MQTT_CA_NAME=ca.crt
# MQTT_DOCS_PROFILE=                              (optional, e.g. nightmare)
# MQTT_AUTH_FAIL_LIMIT=20
